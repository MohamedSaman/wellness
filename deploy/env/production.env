# {{CLIENT}} ({{APP_ENV}}), written by scripts/add-client.sh on {{DATE}}.
# The secrets in this file (APP_KEY, DB_PASSWORD) are also in the client's
# record at Webxkey: without APP_KEY nothing encrypted can be read back
# (docs/deploy/CLOUD.md, "APP_KEY"). After a change: php artisan optimize.
APP_NAME="{{APP_NAME}}"
APP_ENV={{APP_ENV}}
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_URL=https://{{DOMAIN}}
APP_TIMEZONE=UTC

# Install-time only (pos:install); nothing reads it afterwards.
POS_PROFILE={{PROFILE}}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE={{DB_DATABASE}}
DB_USERNAME={{DB_USERNAME}}
DB_PASSWORD={{DB_PASSWORD}}

# Signed-in sessions: in the database, cookies only over HTTPS, encrypted.
# The idle sign-out is in the admin panel (Administration → Security).
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

TRUSTED_PROXIES=127.0.0.1,::1
POS_REQUIRE_2FA=true
# Passwords: 12+ characters for admin users, 10+ for till-only users, none known from a breach.
POS_STRICT_PASSWORDS=true
POS_CSP=true
POS_SCHEDULE_TIMEZONE={{TIMEZONE}}

# Backups (docs/deploy/CLOUD.md, Backups). Encrypted to the offline recovery
# key and this server's verify key; uploaded with rclone to another provider.
POS_BACKUP_LOCAL_PATH=/srv/pos/{{CLIENT}}/backups
POS_BACKUP_AGE_RECIPIENTS={{RECOVERY_RECIPIENT}},{{VERIFY_RECIPIENT}}
POS_BACKUP_AGE_IDENTITY=/srv/pos/{{CLIENT}}/keys/server-verify.key
POS_BACKUP_REMOTE={{BACKUP_REMOTE}}
POS_BACKUP_RCLONE_CONFIG=/srv/pos/{{CLIENT}}/rclone.conf
POS_BACKUP_VERIFY_DATABASE={{DB_DATABASE}}_verify

# Alerts (backup failed, disk full, queue down). Without mail they go to the log.
POS_ALERT_EMAIL={{ALERT_EMAIL}}
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="pos@{{DOMAIN}}"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
