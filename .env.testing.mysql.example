# The MySQL test group (composer test:mysql). Copy to .env.testing.mysql
# (gitignored) and point it at a database used ONLY for tests: every test
# truncates it, and the tests refuse to run unless its name ends in _test.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_pharmacy_test
DB_USERNAME=pos_user
DB_PASSWORD=
